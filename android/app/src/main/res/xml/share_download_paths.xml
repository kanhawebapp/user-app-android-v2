<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides react-native-share's FileProvider paths.
  v12.1.1+ removed root-path and only ships cache-path + external Download/.
  Invoice sharing uses base64 + useInternalStorage (writes under cache/Download).
  files-path remains for any DocumentDir file:// fallback.
  Without a matching path, FileProvider.getUriForFile returns null and
  ClipData.newUri NPEs on Uri.getScheme().
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="rnshare1" path="Download/" />
    <cache-path name="rnshare2" path="." />
    <external-cache-path name="rnshare_ext_cache" path="." />
    <files-path name="rnshare_files" path="." />
</paths>
